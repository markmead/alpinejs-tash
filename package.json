{
  "name": "alpinejs-tash",
  "version": "2.0.1",
  "description": "Alpine JS plugin that enables mustache-like templating syntax for simpler data binding and rendering in your Alpine JS applications 🚀",
  "keywords": [
    "alpine",
    "alpinejs",
    "alpinejs-plugin",
    "templating",
    "interpolation",
    "mustache"
  ],
  "license": "MIT",
  "author": "Mark Mead",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markmead/alpinejs-tash.git"
  },
  "homepage": "https://github.com/markmead/alpinejs-tash#readme",
  "bugs": "https://github.com/markmead/alpinejs-tash/issues",
  "main": "dist/module.cjs",
  "module": "dist/module.mjs",
  "unpkg": "dist/cdn.min.js",
  "exports": {
    ".": {
      "import": "./dist/module.mjs",
      "require": "./dist/module.cjs",
      "default": "./dist/module.mjs"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "packageManager": "pnpm@11.1.3"
}
